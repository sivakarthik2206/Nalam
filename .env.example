# Nalam local development environment (copy to backend/.env).
# Values in this file are examples only. Never commit a real .env file.

# PostgreSQL. SUPABASE_DATABASE_URL, when set, takes precedence in the backend.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nalam
SUPABASE_DATABASE_URL=

# Bolna. Leave blank until a real Tamil agent and backend HTTPS URL are configured.
BOLNA_API_KEY=
BOLNA_AGENT_ID_TAMIL=
BOLNA_WEBHOOK_SECRET=

# Twilio WhatsApp Sandbox. Leave blank to prevent outbound delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# URLs and browser access policy.
BACKEND_PUBLIC_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
DEMO_MODE=false
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Optional allowlisted demo family recipient used by the seed script.
DEMO_FAMILY_WHATSAPP=
# Optional retry override for local demo only. Leave blank for the 30-minute default.
# The current scheduler reads this directly; do not set it in production.
DEMO_RETRY_DELAY_SECONDS=
