# ==========================================
# Nalam (நலம்) - Environment Configuration
# ==========================================

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nalam
# SUPABASE_DATABASE_URL= # Alternative: use Supabase connection string here

# Bolna Voice AI Platform
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID_HINDI=your_hindi_agent_uuid_here
BOLNA_AGENT_ID_TAMIL=your_tamil_agent_uuid_here
BOLNA_AGENT_ID_ENGLISH=your_english_agent_uuid_here

# Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Application URLs
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Next.js Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/dashboard
