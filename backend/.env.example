# Backend-only local development environment.
# Copy this file to backend/.env and replace only with locally held secrets.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nalam
# Optional database override; when non-empty it takes precedence over DATABASE_URL.
SUPABASE_DATABASE_URL=

BOLNA_API_KEY=
BOLNA_AGENT_ID_TAMIL=
BOLNA_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

BACKEND_PUBLIC_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
DEMO_MODE=false
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
DEMO_FAMILY_WHATSAPP=
# Optional retry override for local demo only. Leave blank for the 30-minute default.
# The current scheduler reads this directly; do not set it in production.
DEMO_RETRY_DELAY_SECONDS=
