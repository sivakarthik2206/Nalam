# Nalam backend environment template.
# Copy this file to backend/.env and fill every REQUIRED value before running.
# Never commit backend/.env — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# REQUIRED. The app uses async SQLAlchemy with asyncpg.
# Local dev:     postgresql+asyncpg://postgres:postgres@localhost:5432/nalam
# Supabase:      copy the "Connection string" from Supabase > Settings > Database,
#                switch the scheme from "postgresql://" to "postgresql+asyncpg://",
#                and use the Session/Transaction pooler port (5432 or 6543).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nalam

# Optional override. When non-empty, takes precedence over DATABASE_URL.
# Paste your Supabase connection string here (asyncpg format, see above).
# Leave blank if you are using a local or plain PostgreSQL DATABASE_URL.
SUPABASE_DATABASE_URL=

# ── BOLNA AI ──────────────────────────────────────────────────────────────────
# REQUIRED. Server-only. Never expose in frontend.

# Where to find it: Bolna dashboard → API Keys → copy the key.
BOLNA_API_KEY=

# Where to find it: Bolna dashboard → after importing the Tamil agent from
# bolna-agents/bolna_agent_config.json, copy the agent's UUID from the agent page.
# See PHASE 3 in the deployment README for import instructions.
BOLNA_AGENT_ID_TAMIL=

# Shared HMAC secret used to authenticate Bolna webhook callbacks.
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
# Set the SAME value in the Bolna agent's custom-tool header:
#   Header name:  X-Bolna-Webhook-Secret
#   Header value: <this value>
BOLNA_WEBHOOK_SECRET=

# ── TWILIO ────────────────────────────────────────────────────────────────────
# REQUIRED. Server-only. Never expose in frontend.

# Where to find: Twilio console → Account Info → Account SID.
TWILIO_ACCOUNT_SID=

# Where to find: Twilio console → Account Info → Auth Token (click to reveal).
TWILIO_AUTH_TOKEN=

# WhatsApp sender.
# Sandbox (free, requires join step):  whatsapp:+14155238886
# Production approved sender:          whatsapp:+1XXXXXXXXXX
# Keep the sandbox value unless you have a Twilio-approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── APP URLS ──────────────────────────────────────────────────────────────────
# REQUIRED for live Bolna calls.
# Fill BACKEND_PUBLIC_URL AFTER deploying to Railway (you cannot know this URL
# before deployment). Format: https://your-app.up.railway.app  (no trailing slash)
# Bolna's servers use this URL to call the webhook — localhost will not work.
BACKEND_PUBLIC_URL=

# The deployed frontend URL. Used for dashboard links in WhatsApp messages.
# Format: https://your-app.vercel.app  (no trailing slash)
APP_BASE_URL=

# Same as APP_BASE_URL, used internally for CORS.
FRONTEND_ORIGIN=

# Comma-separated list of allowed browser origins for CORS.
# Must include the Vercel URL once deployed. Example:
#   http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# ── DEMO SETTINGS ─────────────────────────────────────────────────────────────
# REQUIRED. The phone number that receives WhatsApp alerts during the demo.
# E.164 format, e.g. +919876543210
# This number must join the Twilio sandbox first — see deployment README step 9.
DEMO_FAMILY_WHATSAPP=

# Optional. Leave blank to use the production 30-minute retry delay.
# Set to a small integer (e.g. 60) ONLY for local demo runs to see the retry
# call fire quickly. NEVER set this in a production Railway environment variable.
DEMO_RETRY_DELAY_SECONDS=

# ── MISC ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEMO_MODE=true
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
